# MedTokenizers Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ============================================================================
# Weights & Biases (wandb) Configuration
# ============================================================================
# Get your API key from: https://wandb.ai/authorize

# Your wandb API key (required for logging)
WANDB_API_KEY=your_wandb_api_key_here

# Your wandb username or team name
WANDB_ENTITY=your_username_or_team

# Default project name for experiments
WANDB_PROJECT=medtokenizers

# Wandb mode: online, offline, or disabled
# - online: Log to wandb servers (default)
# - offline: Log locally, sync later with 'wandb sync'
# - disabled: Don't log at all
WANDB_MODE=online

# Directory for wandb logs (optional, defaults to ./wandb)
WANDB_DIR=./wandb

# ============================================================================
# HuggingFace Hub Configuration
# ============================================================================
# Get your token from: https://huggingface.co/settings/tokens

# HuggingFace API token (for pushing models to Hub)
HF_TOKEN=your_huggingface_token_here

# Default HuggingFace username or organization
HF_USERNAME=your_hf_username

# ============================================================================
# Training Configuration Defaults
# ============================================================================

# Default checkpoint directory
CHECKPOINT_DIR=./checkpoints

# Default data directory
DATA_DIR=./data

# Default device (cuda, cpu, or auto)
DEVICE=auto

# Number of workers for data loading
NUM_WORKERS=4

# Mixed precision training (true/false)
MIXED_PRECISION=true

# ============================================================================
# Model Defaults
# ============================================================================

# Default spatial compression factor
SPATIAL_COMPRESSION=8

# Default batch size
BATCH_SIZE=32

# Default learning rate
LEARNING_RATE=1e-4

# Allow TF32 matmuls on supported GPUs (true/false)
ALLOW_TF32=true

# Compile the model with torch.compile (true/false)
ENABLE_COMPILE=false

# Use channels-last memory format (true/false)
CHANNELS_LAST=true

# ============================================================================
# Logging and Monitoring
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable progress bars (true/false)
SHOW_PROGRESS=true

# Save frequency (epochs between checkpoints)
SAVE_FREQUENCY=10

# Validation frequency (epochs between validation)
VAL_FREQUENCY=1

# ============================================================================
# Development Settings
# ============================================================================

# Enable debug mode (true/false)
DEBUG=false

# Seed for reproducibility
SEED=42

# Enable deterministic mode (slower but reproducible)
DETERMINISTIC=false

# ============================================================================
# Notes
# ============================================================================
# - Copy this file to .env: cp .env.example .env
# - Fill in your actual values
# - Add .env to .gitignore to keep credentials safe
# - Use python-dotenv to load: from dotenv import load_dotenv; load_dotenv()
# - Access with: import os; api_key = os.getenv('WANDB_API_KEY')
